# Copy this file to .env.local and fill in local secrets.
# Never commit .env.local.
FORGE_SANDBOX_PROVIDER=real-linux-isolated-v1
FORGE_SANDBOX_ENDPOINT=http://127.0.0.1:18080
FORGE_SANDBOX_IMAGE=kali-2026.2-arm64
FORGE_SANDBOX_RUNTIME_MODE=development
FORGE_SANDBOX_RUNTIME_CLASS=vm
FORGE_SANDBOX_CREDENTIAL=<same-secret-as-FORGE_RUNTIME_SERVICE_TOKEN>
FORGE_RUNTIME_SERVICE_TOKEN=<secret>
FORGE_TERMINAL_TICKET_SECRET=<secret>
FORGE_TERMINAL_GATEWAY_URL=ws://127.0.0.1:18081
FORGE_RUNTIME_IMAGE_REF=kali-2026.2-arm64
FORGE_RUNTIME_ARCH=arm64
FORGE_RUNTIME_BIND=127.0.0.1
FORGE_RUNTIME_PORT=18080
FORGE_RUNTIME_SSH_USER=linuxforge
FORGE_RUNTIME_DATA_DIR=.linuxforge-runtime/data
FORGE_RUNTIME_IMAGE_PATH=/absolute/path/to/kali-linux-2026.2-cloud-genericcloud-arm64.qcow2
FORGE_QEMU_ACCEL=hvf
FORGE_QEMU_UEFI_CODE=
